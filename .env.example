# --- Base de datos (Turso) ---
TURSO_DATABASE_URL="libsql://tu-base.turso.io"
TURSO_AUTH_TOKEN="tu-token"

# --- Admin (usuario único) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiame-por-algo-seguro"

# --- Secretos ---
# Generar con: openssl rand -base64 32
AUTH_SECRET="secreto-para-firmar-el-jwt-de-sesion"
IP_SALT="sal-para-hashear-ips-de-votos-y-comentarios"

# --- Imágenes (Vercel Blob) ---
# Se completa automáticamente al linkear Blob en Vercel (vercel env pull)
BLOB_READ_WRITE_TOKEN=""

# --- URL pública del sitio (para SEO, sitemap y RSS) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Newsletter (solo tenants con la feature `newsletter`, p. ej. vt) ---
# Endpoint público de suscripción de listmonk (https://<host>/api/public/subscription).
# Vacío = el formulario se muestra deshabilitado.
NEWSLETTER_SUBSCRIBE_URL=""
# UUIDs de las listas de listmonk, separados por coma
NEWSLETTER_LIST_UUIDS=""
